{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=lawconnect;Username=lawconnect;Password=ChangeMe_StrongPassword!",
    "HangfireConnection": "Host=postgres;Port=5432;Database=lawconnect;Username=lawconnect;Password=ChangeMe_StrongPassword!",
    "Redis": "redis:6379"
  },
  "Jwt": {
    "Secret": "ReplaceWithAtLeast32CharacterSecretKey!",
    "Issuer": "LawConnect",
    "Audience": "LawConnect",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Otp": {
    "HashSecret": "ReplaceWithAtLeast32CharacterOtpHashSecret!",
    "CodeLength": 6,
    "ExpirationMinutes": 5,
    "MaxAttempts": 5,
    "MaxRequestsPerWindow": 3,
    "RequestWindowMinutes": 10
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:8081"
    ]
  },
  "Emergency": {
    "AcceptanceTimeoutSeconds": 30,
    "AllowInternational": false,
    "MaxLawyersPerAttempt": 20
  }
}
