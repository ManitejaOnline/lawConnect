{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lawconnect-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=lawconnect;Username=lawconnect;Password=ChangeMe_StrongPassword!",
    "HangfireConnection": "Host=localhost;Port=5432;Database=lawconnect;Username=lawconnect;Password=ChangeMe_StrongPassword!",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "ReplaceWithAtLeast32CharacterSecretKey!",
    "Issuer": "LawConnect",
    "Audience": "LawConnect",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Otp": {
    "HashSecret": "ReplaceWithAtLeast32CharacterOtpHashSecret!",
    "CodeLength": 6,
    "ExpirationMinutes": 5,
    "MaxAttempts": 5,
    "MaxRequestsPerWindow": 3,
    "RequestWindowMinutes": 10
  },
  "Storage": {
    "RootPath": "storage",
    "PublicBaseUrl": "/files",
    "MaxUploadBytes": 10485760
  },
  "AwsS3": {
    "Enabled": false,
    "Region": "ap-south-1",
    "BucketName": "lawconnect",
    "UploadUrlExpirationMinutes": 15,
    "DownloadUrlExpirationMinutes": 60
  },
  "Firebase": {
    "Enabled": false,
    "ServiceAccountPath": "",
    "ProjectId": ""
  },
  "Emergency": {
    "AcceptanceTimeoutSeconds": 30,
    "AllowInternational": false,
    "MaxLawyersPerAttempt": 20
  },
  "LawyerVerification": {
    "RequiredDocumentTypes": [ "BarCouncilCertificate", "GovernmentId" ]
  },
  "Payments": {
    "Provider": "Fake",
    "Currency": "INR",
    "IdempotencyTtlHours": 24,
    "OutboxMaxAttempts": 5,
    "Razorpay": {
      "KeyId": "",
      "KeySecret": "",
      "WebhookSecret": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:8081"
    ]
  },
  "AllowedHosts": "*"
}
