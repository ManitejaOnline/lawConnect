{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "HangfireConnection": "",
    "Redis": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "LawConnect",
    "Audience": "LawConnect",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Otp": {
    "HashSecret": "",
    "CodeLength": 6,
    "ExpirationMinutes": 5,
    "MaxAttempts": 5,
    "MaxRequestsPerWindow": 3,
    "RequestWindowMinutes": 10
  },
  "Cors": {
    "AllowedOrigins": [
      "https://lawconnect-uddw.onrender.com"
    ]
  },
  "Storage": {
    "RootPath": "storage",
    "PublicBaseUrl": "/files",
    "MaxUploadBytes": 10485760
  },
  "AwsS3": {
    "Enabled": false,
    "Region": "ap-south-1",
    "BucketName": "",
    "AccessKey": "",
    "SecretKey": ""
  },
  "Firebase": {
    "Enabled": false
  },
  "Payments": {
    "Provider": "Fake",
    "Currency": "INR"
  },
  "Emergency": {
    "AcceptanceTimeoutSeconds": 30,
    "AllowInternational": false,
    "MaxLawyersPerAttempt": 20
  },
  "Database": {
    "ApplyMigrations": true
  },
  "AllowedHosts": "*"
}
