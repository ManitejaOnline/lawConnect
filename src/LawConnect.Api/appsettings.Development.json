      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=55432;Database=lawconnect;Username=lawconnect;Password=ChangeMe_StrongPassword!",
    "HangfireConnection": "Host=localhost;Port=55432;Database=lawconnect;Username=lawconnect;Password=ChangeMe_StrongPassword!",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "DevOnly_ReplaceWithAtLeast32CharacterSecret!",
    "Issuer": "LawConnect",
