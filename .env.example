POSTGRES_USER=lawconnect
POSTGRES_PASSWORD=ChangeMe_StrongPassword!
POSTGRES_DB=lawconnect
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
JWT_SECRET=ReplaceWithAtLeast32CharacterSecretKey!
JWT_ISSUER=LawConnect
JWT_AUDIENCE=LawConnect

# Initial admin portal account (bootstrapped on API startup, idempotent — only
# used the first time no matching admin account exists yet)
ADMIN_USERNAME=admin@lawconnect.local
ADMIN_PASSWORD=<secure password>

# Emergency SOS escalation (km CSV + seconds per notify round)
EMERGENCY_RADII=10,25,50,100
EMERGENCY_ROUND_SECONDS=30

# --- Render / Production (set in the Render Dashboard; do not commit real values) ---
# ASPNETCORE_ENVIRONMENT=Production
# Database__ApplyMigrations=true
# ConnectionStrings__DefaultConnection=<Render PostgreSQL Internal Database URL>
# ConnectionStrings__HangfireConnection=<same Postgres URL>
# ConnectionStrings__Redis=<Render Key Value Internal Redis URL>
# Jwt__Secret=<at least 32 characters>
# Jwt__Issuer=LawConnect
# Jwt__Audience=LawConnect
# Otp__HashSecret=<at least 32 characters>
# Cors__AllowedOrigins__0=https://lawconnect-uddw.onrender.com
# Firebase__Enabled=false
# Payments__Provider=Fake
# Case documents in Production MUST use S3 (Render disk is not durable).
# AwsS3__Enabled=true
# AwsS3__Region=ap-south-1
# AwsS3__BucketName=<your-private-bucket>
# AwsS3__AccessKey=<optional if using IAM>
# AwsS3__SecretKey=<optional if using IAM>
