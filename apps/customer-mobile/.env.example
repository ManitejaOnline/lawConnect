# LawConnect HTTP API origin — NOT the Expo bundler URL (exp://...).
#
# Web / iOS Simulator:
#   EXPO_PUBLIC_API_URL=http://localhost:5080
#
# Physical phone (Expo Go on same Wi-Fi as the PC):
#   1. Start the API on port 5080.
#   2. Run `ipconfig` and copy the Wi-Fi IPv4 address.
#   3. Set:
#        EXPO_PUBLIC_API_URL=http://<PC-LAN-IP>:5080
#      Example shape only: http://192.168.1.100:5080
#   4. Phone and PC must be on the same network.
#   5. Allow TCP 5080 through Windows Firewall if prompted.
#   6. Restart Expo (`npx expo start --tunnel`) so this value is baked in.
#   7. Open the app in Expo Go via exp://... (bundler only).
#
# Production / EAS preview+production (also in .env.production and eas.json):
#   EXPO_PUBLIC_API_URL=https://lawconnect-uddw.onrender.com
#
# Copy to `.env` (gitignored) for local Expo Go. Never commit a machine-specific IP.
EXPO_PUBLIC_API_URL=http://localhost:5080
