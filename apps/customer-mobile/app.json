{
  "expo": {
    "name": "LawConnect",
    "slug": "lawconnect-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "lawconnect",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lawconnect.customer",
      "infoPlist": {
        "NSCameraUsageDescription": "LawConnect needs camera access for video consultations.",
        "NSMicrophoneUsageDescription": "LawConnect needs microphone access for voice and video calls.",
        "LSApplicationQueriesSchemes": [
          "tel"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.lawconnect.customer",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F33",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LawConnect uses your location to show nearby lawyers."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LawConnect uses your photos for a lawyer profile picture."
        }
      ],
      "expo-document-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LawConnect to use your camera for video calls.",
          "microphonePermission": "Allow LawConnect to use your microphone for calls.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "usesCleartextTraffic": true,
            "manifestQueries": {
              "intent": [
                {
                  "action": "android.intent.action.DIAL",
                  "data": {
                    "scheme": "tel"
                  }
                },
                {
                  "action": "android.intent.action.VIEW",
                  "data": {
                    "scheme": "tel"
                  }
                }
              ]
            }
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e6c32e0a-c881-4300-a7e6-f0f71d40b146"
      }
    },
    "owner": "mani003"
  }
}
